      { id: 'dinheiro', label: 'Dinheiro', diff: cashDifference, order: 1 },
      { id: 'pix', label: 'Pix', diff: getnetPix - jclanPix, order: 2 },
      {
        id: 'credito',
        label: 'Crédito',
        diff: getnetCredit - jclanCredit,
        order: 3,
      },
      {
        id: 'debito',
        label: 'Débito',
        diff: getnetDebit - jclanDebit,
        order: 4,
      },
      {
        id: 'voucher',
        label: 'Voucher',
        diff: getnetVoucher - jclanVoucher,
        order: 5,
      },
    ];

    let needs = diffs
      .filter((d) => d.diff > 0.01)
      .map((d) => ({ ...d, amount: d.diff }))
      .sort((a, b) => a.order - b.order);
    let excesses = diffs
      .filter((d) => d.diff < -0.01)
      .map((d) => ({ ...d, amount: Math.abs(d.diff) }))
      .sort((a, b) => a.order - b.order);

    let instructions = [];
    let nIdx = 0,
      eIdx = 0;

    while (nIdx < needs.length && eIdx < excesses.length) {
      let need = needs[nIdx];
      let excess = excesses[eIdx];
      let transferAmount = Math.min(need.amount, excess.amount);

      if (transferAmount > 0.01) {
        instructions.push({
          from: excess.label,
          to: need.label,
          amount: transferAmount,
        });
      }
      need.amount -= transferAmount;
      excess.amount -= transferAmount;
      if (need.amount <= 0.01) nIdx++;
      if (excess.amount <= 0.01) eIdx++;
    }

    let unresolvable = [];
    while (nIdx < needs.length) {
      if (needs[nIdx].amount > 0.01)
        unresolvable.push({
          type: 'sobra',
          label: needs[nIdx].label,
          amount: needs[nIdx].amount,
        });
      nIdx++;
