const LoginScreen = ({ operators, onLogin, onRegister, isAuthReady }) => {
  const [view, setView] = useState('list');
  const [selectedOp, setSelectedOp] = useState(null);
  const [password, setPassword] = useState('');
  const [newName, setNewName] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [error, setError] = useState('');

  useEffect(() => {
    if (isAuthReady && operators.length === 0) {
      setView('setup');
    } else if (isAuthReady && operators.length > 0 && view === 'setup') {
      setView('list');
    }
  }, [operators, isAuthReady, view]);

  const handleLoginSubmit = (e) => {
    e.preventDefault();
    if (selectedOp.password === password) {
      onLogin(selectedOp);
    } else {
      setError('Senha incorreta!');
      setTimeout(() => setError(''), 3000);
    }
  };

  const handleSetupSubmit = (e) => {
    e.preventDefault();
    if (!newName || !newPassword) return;
    onRegister(newName, newPassword, true);
  };

  if (!isAuthReady) {
    return (
      <div className="min-h-screen bg-slate-100 flex items-center justify-center">
        <div className="w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-100 flex items-center justify-center p-4">
      <div className="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden">
        <div className="bg-slate-800 p-6 text-center">
          <div className="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-inner">
            <IconUser />
          </div>
          <h1 className="text-xl font-black text-white uppercase tracking-wider">
            Fechamento de Caixa
          </h1>
          <p className="text-blue-300 text-sm mt-1">Autenticação do Operador</p>
        </div>

        <div className="p-6">
          {error && (
            <div className="mb-4 p-3 bg-rose-50 text-rose-700 border border-rose-200 rounded-lg text-sm font-bold flex items-center justify-center gap-2">
              <IconAlert /> {error}
            </div>
          )}

          {view === 'setup' && (
            <form onSubmit={handleSetupSubmit} className="space-y-4">
              <div className="text-center mb-6">
                <div className="bg-blue-100 text-blue-700 p-3 rounded-lg text-xs font-bold mb-4">
                  Nenhum usuário detectado. Configure a conta do Administrador
                  principal (Bruno) para liberar o sistema.
                </div>
                <h2 className="text-sm font-bold text-slate-500 uppercase tracking-wider mb-2">
                  Criar Administrador
                </h2>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-500 uppercase mb-2 ml-1">
                  Seu Nome
                </label>
                <input
                  type="text"
                  value={newName}
                  onChange={(e) => setNewName(e.target.value)}
                  className="w-full bg-slate-50 border border-slate-300 rounded-xl py-3 px-4 font-bold text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none transition-all"
                  placeholder="Ex: Bruno"
                  required
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-500 uppercase mb-2 ml-1">
                  Criar Senha de Admin
                </label>
                <input
                  type="text"
                  value={newPassword}
                  onChange={(e) => setNewPassword(e.target.value)}
                  className="w-full bg-slate-50 border border-slate-300 rounded-xl py-3 px-4 font-bold text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none transition-all"
                  placeholder="Senha segura"
                  required
                />
              </div>

              <div className="pt-2">
                <button
                  type="submit"
                  className="w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 transition-colors shadow-sm flex items-center justify-center gap-2"
                >
                  <IconShield /> Salvar Admin e Iniciar
                </button>
              </div>
            </form>
          )}

          {view === 'list' && (
            <>
              <h2 className="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4 text-center">
                Selecione seu Usuário
              </h2>
              <div className="grid grid-cols-2 gap-3 mb-2">
                {operators.map((op) => (
                  <button
                    key={op.id}
                    onClick={() => {
                      setSelectedOp(op);
                      setView('login');
                      setPassword('');
                    }}
                    className="w-full bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-blue-300 text-slate-700 font-bold py-3 px-2 rounded-xl transition-all shadow-sm flex flex-col items-center gap-2"
                  >
                    <div className="w-8 h-8 bg-slate-200 rounded-full flex items-center justify-center text-slate-500 relative">
                      <IconUser />
                      {op.isAdmin && (
                        <div className="absolute -bottom-1 -right-1 bg-blue-500 text-white p-0.5 rounded-full">
                          <IconShield />
                        </div>
                      )}
                    </div>
                    <span className="truncate w-full text-center text-sm">
                      {op.name}
                    </span>
                  </button>
                ))}
              </div>
            </>
          )}

          {view === 'login' && selectedOp && (
            <form onSubmit={handleLoginSubmit} className="space-y-4">
              <div className="text-center mb-6">
                <p className="text-sm text-slate-500 mb-1">Entrando como:</p>
                <p className="text-xl font-bold text-slate-800 flex items-center justify-center gap-2">
                  {selectedOp.name}{' '}
                  {selectedOp.isAdmin && (
                    <span className="text-blue-500">
                      <IconShield />
                    </span>
                  )}
                </p>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-500 uppercase mb-2 ml-1">
                  Senha de Acesso
                </label>
                <div className="relative">
                  <span className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                    <IconLock />
                  </span>
                  <input
                    type="password"
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded-xl py-3 pl-10 pr-4 text-center font-black tracking-[0.3em] text-lg focus:ring-2 focus:ring-blue-500 outline-none transition-all"
                    placeholder="••••"
                    autoFocus
                  />
                </div>
              </div>

              <div className="pt-2 flex gap-3">
                <button
                  type="button"
                  onClick={() => setView('list')}
                  className="flex-1 bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition-colors"
                >
                  Voltar
                </button>
                <button
                  type="submit"
                  className="flex-[2] bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 transition-colors shadow-sm"
                >
                  Entrar
                </button>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  );
};

const AdminPanel = ({
  operators,
  onRegister,
  onDelete,
  db,
  appId,
  onClose,
  onLogout,
  currentUser,
}) => {
  const [closings, setClosings] = useState([]);
  const [newName, setNewName] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [error, setError] = useState('');

  useEffect(() => {
    if (!db || !appId) return;
    const closingsRef = collection(
      db,
      'artifacts',
      appId,
      'public',
      'data',
      'closings'
    );
    const unsubscribe = onSnapshot(
      closingsRef,
      (snapshot) => {
        const data = snapshot.docs.map((doc) => ({
          id: doc.id,
          ...doc.data(),
        }));
        data.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
        setClosings(data);
      },
      (err) => console.error('Erro Closings:', err)
    );
    return () => unsubscribe();
  }, [db, appId]);

  const handleAdd = (e) => {
    e.preventDefault();
    if (!newName || !newPassword) return;
    if (operators.length >= 10) {
      setError('Limite de 10 operadores atingido.');
      setTimeout(() => setError(''), 4000);
      return;
    }
    onRegister(newName, newPassword, false);
    setNewName('');
    setNewPassword('');
  };

  return (
    <div className="min-h-screen bg-slate-50 pb-20 font-sans text-slate-800">
      <div className="bg-slate-900 text-white px-6 py-4 flex justify-between items-center shadow-md">
        <div className="flex items-center gap-3">
          <div className="bg-blue-600 p-2 rounded-lg">
            <IconShield />
          </div>
          <div>
            <h1 className="font-black text-lg leading-tight">
              Painel do Administrador
            </h1>
            <p className="text-blue-300 text-xs">
              Gestão de Usuários e Auditoria
            </p>
          </div>
        </div>
        <div className="flex items-center gap-4">
          <button
            onClick={onClose}
            className="flex items-center gap-2 text-slate-300 hover:text-white bg-slate-800 px-4 py-2 rounded-lg font-bold transition-colors text-sm"
          >
            Ir para o Caixa
