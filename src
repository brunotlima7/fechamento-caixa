                      <div key={type}>
                        <div className="flex justify-between items-center mb-1.5">
                          <div className="flex items-center gap-2">
                            <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                              {type === 'credits'
                                ? 'Crédito'
                                : type === 'debits'
                                ? 'Débito'
                                : 'Voucher'}
                            </span>
                            <button
                              onClick={() => handleAddField(machine.id, type)}
                              className="w-5 h-5 flex items-center justify-center bg-slate-200 hover:bg-blue-100 text-slate-500 rounded"
                            >
                              <IconPlus />
                            </button>
                          </div>
                          <span
                            className={`text-[11px] font-bold ${
                              type === 'credits'
                                ? 'text-blue-600'
                                : type === 'debits'
                                ? 'text-orange-500'
                                : 'text-purple-500'
                            }`}
                          >
                            {formatCurrency(sumArray(machine[type]))}
                          </span>
                        </div>
                        <div className="grid grid-cols-5 gap-1.5 mt-1.5">
                          {machine[type].map((val, idx) => (
                            <input
                              key={`${type}-${idx}`}
                              id={`input-${machine.id}-${type}-${idx}`}
                              type="text"
                              placeholder="0,00"
                              value={val}
                              onChange={(e) =>
                                handleArrayChange(
                                  machine.id,
                                  type,
                                  idx,
                                  e.target.value
                                )
                              }
                              onKeyDown={(e) =>
                                handleKeyDown(e, machine.id, type, idx)
                              }
                              className={`w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-0.5 text-center font-medium focus:ring-2 focus:ring-blue-500 outline-none transition-all ${
                                isCompactView ? 'text-xs' : 'text-sm'
                              }`}
                            />
                          ))}
                        </div>
                      </div>
                    ))}
                    <div>
                      <div className="flex justify-between items-center mb-1.5">
                        <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                          Pix
                        </span>
                        <span className="text-[11px] font-bold text-teal-500">
                          {formatCurrency(parseValue(machine.pix))}
                        </span>
                      </div>
                      <input
                        id={`input-${machine.id}-pix-0`}
                        type="text"
                        placeholder="0,00"
                        value={machine.pix}
                        onChange={(e) =>
                          handlePixChange(machine.id, e.target.value)
                        }
                        onKeyDown={(e) =>
                          handleKeyDown(e, machine.id, 'pix', 0)
                        }
                        className={`w-full bg-slate-50 border border-slate-200 rounded-lg py-1.5 px-3 font-medium focus:ring-2 focus:ring-blue-500 outline-none transition-all ${
                          isCompactView ? 'text-xs' : 'text-sm'
                        }`}
                      />
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        {/* PASSO 3 - Assistente */}
        <div className="mt-10">
          <div className="bg-slate-900 rounded-xl shadow-xl border border-slate-800 overflow-hidden">
            <div className="p-4 bg-slate-800 border-b border-slate-700 flex items-center gap-3">
              <span className="flex items-center justify-center w-8 h-8 rounded-full bg-blue-600 text-white font-black text-sm shadow-inner">
                3
              </span>
              <h3 className="text-lg font-bold text-white flex-1">
                Assistente de Correção no Jclan
              </h3>
              {!hasDivergences && (
                <span className="bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full text-xs font-bold border border-emerald-500/30 flex items-center gap-1">
                  <IconCheck /> Perfeito
                </span>
              )}
            </div>

            <div className="p-6">
              {!hasDivergences ? (
                <div className="flex flex-col items-center justify-center py-8 text-emerald-400 space-y-3">
                  <div className="w-16 h-16 rounded-full bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20">
                    <IconCheck />
                  </div>
                  <p className="font-bold text-lg text-emerald-300">
                    Caixa Batendo 100%!
                  </p>
                </div>
              ) : (
                <div className="space-y-6">
                  {instructions.length > 0 && (
                    <div>
                      <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2">
                        <IconRefresh /> Instruções de Mudança no Sistema
                      </h4>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {instructions.map((inst, idx) => (
                          <div
                            key={idx}
                            className="bg-slate-800/50 border border-blue-500/30 rounded-lg p-4 flex flex-col justify-center"
                          >
                            <p className="text-slate-300 text-sm">
                              Abra as comandas e altere{' '}
                              <span className="font-bold text-white bg-slate-700 px-2 py-0.5 rounded text-base">
                                {formatCurrency(inst.amount)}
                              </span>
                            </p>
                            <div className="flex items-center gap-2 mt-2 font-bold text-sm">
                              <span className="text-rose-400 line-through decoration-rose-500/50">
                                de {inst.from}
                              </span>
                              <span className="text-slate-500">➜</span>
                              <span className="text-emerald-400">
                                para {inst.to}
                              </span>
                            </div>
                            {inst.from === 'Dinheiro' && (
                              <div className="mt-3 text-xs text-amber-300 bg-amber-500/10 p-2.5 rounded-md border border-amber-500/20">
                                <strong>✅ Acerto via Hierarquia:</strong>{' '}
                                Usamos a diferença que sobrou em{' '}
                                <strong>{inst.to}</strong> para abater a falta
                                do dinheiro. Abra as comandas e faça a alteração
                                para cobrir o furo!
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {unresolvable.length > 0 && (
                    <div
                      className={
                        instructions.length > 0
                          ? 'pt-6 border-t border-slate-700'
                          : ''
                      }
                    >
                      <h4 className="text-xs font-bold text-rose-400/80 uppercase tracking-wider mb-3 flex items-center gap-2">
                        <IconAlert /> Divergências Reais (Quebra)
                      </h4>
                      <div className="space-y-2">
                        {unresolvable.map((unres, idx) => (
                          <div
                            key={idx}
                            className={`p-3 rounded-lg border flex items-center gap-3 ${
                              unres.type === 'sobra'
                                ? 'bg-amber-500/10 border-amber-500/20 text-amber-300'
                                : 'bg-rose-500/10 border-rose-500/20 text-rose-300'
                            }`}
                          >
                            <div className="flex-1 font-medium text-sm">
                              {unres.type === 'sobra' ? (
                                <>
                                  Existe uma{' '}
                                  <strong className="text-amber-400">
                                    SOBRA REAL de {formatCurrency(unres.amount)}{' '}
                                    em {unres.label}
                                  </strong>
                                  .<br />
                                  <span className="text-amber-200/80 text-xs mt-1 block font-bold">
                                    ➜ INSTRUÇÃO: Abra uma comanda no sistema
                                    Jclan e lance esse valor (ex: itens
                                    consumidos e não cobrados).
                                  </span>
                                </>
                              ) : (
                                <>
                                  Existe uma{' '}
                                  <strong className="text-rose-400">
                                    FALTA REAL de {formatCurrency(unres.amount)}{' '}
                                    em {unres.label}
                                  </strong>
                                  .<br />
                                  <span className="text-rose-200/80 text-xs mt-1 block font-bold">
                                    ➜ INSTRUÇÃO: Abra uma comanda fechada em{' '}
                                    {unres.label} no Jclan e exclua itens até
                                    corrigir o valor.
                                  </span>
                                </>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

:root {
  --text: #6b6375;
  --text-h: #08060d;
  --bg: #fff;
  --border: #e5e4e7;
  --code-bg: #f4f3ec;
  --accent: #aa3bff;
  --accent-bg: rgba(170, 59, 255, 0.1);
  --accent-border: rgba(170, 59, 255, 0.5);
  --social-bg: rgba(244, 243, 236, 0.5);
  --shadow:
    rgba(0, 0, 0, 0.1) 0 10px 15px -3px, rgba(0, 0, 0, 0.05) 0 4px 6px -2px;

  --sans: system-ui, 'Segoe UI', Roboto, sans-serif;
  --heading: system-ui, 'Segoe UI', Roboto, sans-serif;
  --mono: ui-monospace, Consolas, monospace;

  font: 18px/145% var(--sans);
  letter-spacing: 0.18px;
  color-scheme: light dark;
  color: var(--text);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  @media (max-width: 1024px) {
    font-size: 16px;
  }
}

@media (prefers-color-scheme: dark) {
  :root {
    --text: #9ca3af;
    --text-h: #f3f4f6;
    --bg: #16171d;
    --border: #2e303a;
    --code-bg: #1f2028;
    --accent: #c084fc;
    --accent-bg: rgba(192, 132, 252, 0.15);
    --accent-border: rgba(192, 132, 252, 0.5);
    --social-bg: rgba(47, 48, 58, 0.5);
    --shadow:
      rgba(0, 0, 0, 0.4) 0 10px 15px -3px, rgba(0, 0, 0, 0.25) 0 4px 6px -2px;
  }

  #social .button-icon {
    filter: invert(1) brightness(2);
  }
}

body {
  margin: 0;
}

#root {
  width: 1126px;
  max-width: 100%;
  margin: 0 auto;
  text-align: center;
  border-inline: 1px solid var(--border);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

h1,
h2 {
  font-family: var(--heading);
  font-weight: 500;
  color: var(--text-h);
}

h1 {
  font-size: 56px;
  letter-spacing: -1.68px;
  margin: 32px 0;
  @media (max-width: 1024px) {
    font-size: 36px;
    margin: 20px 0;
  }
}
h2 {
  font-size: 24px;
  line-height: 118%;
  letter-spacing: -0.24px;
  margin: 0 0 8px;
  @media (max-width: 1024px) {
    font-size: 20px;
  }
}
p {
  margin: 0;
}

code,
.counter {
  font-family: var(--mono);
  display: inline-flex;
  border-radius: 4px;
  color: var(--text-h);
}

code {
  font-size: 15px;
  line-height: 135%;
  padding: 4px 8px;
  background: var(--code-bg);
}

